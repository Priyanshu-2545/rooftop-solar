{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:cov)",
      "Bash(npm run build)",
      "Bash(npm run e2e)",
      "Bash(npm run db:generate)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": ["Bash(git push --force:*)", "Bash(rm -rf:*)", "Bash(git reset --hard:*)"]
  }
}
